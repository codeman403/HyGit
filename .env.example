# ── HydraDB ──────────────────────────────────────────────────────────────────
HYDRA_DB_API_KEY=hdb_your_key_here
HYDRADB_BASE_URL=https://api.hydradb.com

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_here

# ── Supabase (PostgreSQL) ─────────────────────────────────────────────────────
# Find this in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "URI" format, switch mode to "Session" for direct connection.
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Find this in: Upstash Console → Your Database → REST API → .env tab
# Use the rediss:// (TLS) URL for production.
# Format: rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=rediss://default:your_password@your-db.upstash.io:6379
CACHE_TTL_SECONDS=3600

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HyGit
